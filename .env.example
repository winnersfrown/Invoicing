# Scripted investigation is the default, even when an API key is present.
AGENT_MODE=scripted
# Only needed after deliberately opting into paid mode:
# AGENT_MODE=openai
# OPENAI_MODEL=gpt-6-luna
# OPENAI_API_KEY=configure-only-in-server-environment
# Shared production workspace additionally needs:
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
# Enable after configuring verified signup emails and the Rekono redirect URL in Supabase Auth:
# PUBLIC_SIGNUP=true
RATE_LIMIT_PER_MINUTE=10
